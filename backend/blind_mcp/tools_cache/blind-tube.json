          },
          "nome_arquivo": {
            "default": "",
            "title": "Nome Arquivo",
            "type": "string"
          },
          "inicio_segundos": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Inicio Segundos"
          },
          "fim_segundos": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Fim Segundos"
          }
        },
        "required": [
          "fonte"
        ],
        "title": "blindtube_convert_audioArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "additionalProperties": true,
            "title": "Result",
            "type": "object"
          }
        },
        "required": [
          "result"
        ],
        "title": "blindtube_convert_audioOutput",
        "type": "object"
      }
    },
    {
      "name": "blindtube_info",
      "description": "Mostra informacoes rapidas de um video do YouTube antes de resumir, baixar ou converter:\ntitulo, canal, duracao falada, visualizacoes, descricao resumida, capitulos, legendas e qualidades disponiveis.\nSe receber texto livre em vez de link, devolve opcoes da busca no YouTube para escolher.\n",
