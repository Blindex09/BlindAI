          "result"
        ],
        "title": "whatsapp_statusOutput",
        "type": "object"
      }
    },
    {
      "name": "whatsapp_messages",
      "description": "Lista as mensagens de WhatsApp recebidas desde que o conector ligou (mais novas primeiro): de quem, nome, texto, tipo\n(texto, audio, imagem, video, documento) e o arquivo baixado. Para a pessoa cega entender a conversa, por padrao as\nmidias mais recentes (ate max_midias) ja voltam entendidas: audio e video com `transcricao` (o que foi falado), foto e\nvideo com `descricao` (audiodescricao). Midia alem do limite volta sem isso: diga que ha mais e ofereca. Use\nentender_midias=false so se a pessoa pedir so os textos. So le; nao responde nem marca como lida. Nao traz mensagens\nantigas, so as que chegam depois do conector ligar. Exige o WhatsApp pareado.",
      "inputSchema": {
        "properties": {
          "limit": {
            "default": 20,
            "title": "Limit",
            "type": "integer"
          },
          "entender_midias": {
            "default": true,
            "title": "Entender Midias",
            "type": "boolean"
          },
          "max_midias": {
            "default": 6,
            "title": "Max Midias",
            "type": "integer"
          }
        },
        "title": "whatsapp_messagesArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "additionalProperties": true,
            "title": "Result",
            "type": "object"
          }
        },
        "required": [
          "result"
        ],
        "title": "whatsapp_messagesOutput",
        "type": "object"
      }
    },
