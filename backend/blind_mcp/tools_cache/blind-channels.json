  "tools": [
    {
      "name": "whatsapp_pair",
      "description": "Pareia o WhatsApp da pessoa pelo conector real (Baileys): devolve o codigo de 8 caracteres que o PROPRIO WhatsApp gerou\n(vale poucos minutos) e como digita-lo no celular (Aparelhos Conectados > Conectar com numero de telefone). So chame se a\npessoa pedir e der o numero com DDD. Se o conector nao estiver instalado, devolve erro e NAO gera codigo.",
      "inputSchema": {
        "properties": {
          "phone": {
            "title": "Phone",
            "type": "string"
          }
        },
        "required": [
          "phone"
        ],
        "title": "whatsapp_pairArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "additionalProperties": true,
            "title": "Result",
            "type": "object"
          }
        },
        "required": [
          "result"
        ],
        "title": "whatsapp_pairOutput",
        "type": "object"
      }
    },
    {
